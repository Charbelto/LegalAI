# Copy to .env and fill in. .env is gitignored; never commit a real key.
# Loaded automatically by env_loader.py, so plain `python ...` runs see these too.

# --- Backend runtime ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
# Embeddings (retrieval) always run locally via Ollama, regardless of
# GENERATION_PROVIDER below - only chat/generation calls can move to DeepSeek.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Generation (the system under test - NOT the judge, see below) ---
# 'local_peft' (default since the PEFT pivot): three DIFFERENT small open-weight
#   models, one per domain expert, each 4-bit quantised and each carrying its own
#   QLoRA adapter. Fully offline generation; this is what the paper measures.
# 'ollama': one shared local model (qwen2.5) for every agent - the pre-pivot
#   setup. Still fully supported.
# 'deepseek': hosted DeepSeek V4 Flash for every agent. Do NOT use this together
#   with a DeepSeek judge: that is a model grading its own answers, which was a
#   disclosed limitation of the pre-pivot paper and is exactly what the pivot
#   removes.
GENERATION_PROVIDER=local_peft
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Local PEFT experts (GENERATION_PROVIDER=local_peft) ---
# One base model per expert, three distinct families. Defaults are set in
# config.py; override here only to change models.
#   legal      unsloth/Llama-3.2-3B-Instruct        (ungated mirror of Meta's
#              weights; meta-llama/Llama-3.2-3B-Instruct is gated="manual" and
#              needs an accepted licence plus HF_TOKEN)
#   news       Qwen/Qwen2.5-3B-Instruct
#   general_qa ibm-granite/granite-3.1-2b-instruct
# LEGALAI_LEGAL_BASE_MODEL=unsloth/Llama-3.2-3B-Instruct
# LEGALAI_NEWS_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
# LEGALAI_GENERAL_BASE_MODEL=ibm-granite/granite-3.1-2b-instruct
#
# THE ABLATION SWITCH (RQ2). 1 = load each expert's LoRA adapter ("peft" arm);
# 0 = identical base models, no adapter ("base" control arm). run_experiment.ps1
# runs both and benchmark.py records the arm on every row - never set this by
# hand for a benchmark, or the rows may be labelled with the wrong arm.
LEGALAI_USE_ADAPTERS=1
# LEGALAI_ADAPTER_DIR=adapters
#
# Prompt-context ceiling for the local models. Sized from measured prompts: the
# experts need ~2100 tokens, the aggregator ~4500 (it receives the retrieved
# context plus three expert answers) and it runs alone. Verify any change with
#   python finetune\check_vram.py --concurrent
# LEGALAI_LOCAL_MAX_INPUT_TOKENS=6144
#
# Off by default and load-bearing: with trust_remote_code=1, Phi-family repos
# load their own bundled modelling code, which uses the pre-4.47 KV-cache API and
# dies on the first generate() under transformers 5.x.
# LEGALAI_TRUST_REMOTE_CODE=0

# --- Live legal search (interactive use only) ---
# Searches EUR-Lex and the Commission's digital-strategy pages for material
# published since the static corpus was ingested. OFF by default and forced off
# by benchmark.py: a context that depends on what the web returned this minute
# makes two runs of the same query incomparable, so any topology difference would
# be partly a fetch difference. Same reasoning as fetch_news=False in a run.
LEGALAI_ENABLE_EURLEX_LIVE=0

# --- Experiment settings ---
# 0 = sample with a per-repeat seed, so repeats carry variance (required for CIs).
# 1 = greedy decoding; every repeat is identical, use only with BENCH_REPEATS=1.
LEGALAI_DETERMINISTIC=0
LEGALAI_NUM_CTX=8192
# Canned COMPL-AI demo answers bypass the agent graph. Never 1 during an experiment.
LEGALAI_ENABLE_COMPL_AI=0
# Only affects GENERATION_PROVIDER=ollama: without it, "parallel" topologies are
# silently serialised. Irrelevant to local_peft (each expert holds its own model
# and LangGraph fans them out directly) but harmless to leave set - embeddings
# still run on local Ollama either way.
OLLAMA_NUM_PARALLEL=4

# --- Judge (separate from GENERATION_PROVIDER above - this only scores
# already-generated answers, it does not generate them) ---
# CURRENT DEFAULT: hosted DeepSeek V4 Flash. Cheap (~$1-2 for a 540-run pass) and
# strong enough to judge reliably. Since the PEFT pivot it is also genuinely
# independent: it no longer generates any of the answers it scores, which is what
# retires the self-preference-bias caveat the pre-pivot paper had to disclose.
# Keep it that way - do not set GENERATION_PROVIDER=deepseek alongside it.
#
# >>> ADD YOUR KEY HERE <<<
JUDGE_PROVIDER=deepseek
JUDGE_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Validate before spending on the full pass:
#   python llm_judge.py --check     (one call, confirms id + cost)
#   .\run_experiment.ps1 -SkipBenchmark

# ALTERNATIVE (local, free) - not removed, just no longer the default. Switch
# back any time by uncommenting these two lines (and commenting the deepseek
# ones above). Must be a model that is NOT qwen2.5 (the system under test) and
# NOT llama3.1:8b (which drafted the reference answers) - e.g. gemma4:12b.
#   JUDGE_PROVIDER=ollama
#   JUDGE_MODEL=gemma4:12b

# ALTERNATIVE (hosted, OpenAI) - same OpenAI-compatible code path, different key:
#   JUDGE_PROVIDER=openai
#   JUDGE_MODEL=<model id>
#   OPENAI_API_KEY=sk-...
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $env:OPENAI_API_KEY"

# The judge cache is keyed by provider+model, so switching providers never
# reuses another provider's cached scores. Snapshot before switching if you want
# to keep comparing two judges side by side:
#   python scripts\snapshot_run.py --label <old-provider>-judge

# Hard stop once cumulative spend reaches this. Tracked in judge_spend.json across
# runs; cached scores are never re-paid for.
JUDGE_BUDGET_USD=3.00

# Used only to track spend against the budget. VERIFY against current pricing --
# these are per million tokens. Defaults below are DeepSeek V4 Flash's
# cache-miss rates; change if you switch JUDGE_PROVIDER to openai or ollama (0/0).
JUDGE_PRICE_IN_PER_M=0.14
JUDGE_PRICE_OUT_PER_M=0.28

# Model that drafted the reference answers, recorded for provenance.
GOLD_MODEL=llama3.1:8b

# --- Frontend / CORS ---
LEGALAI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LEGALAI_SERVE_STATIC=0
